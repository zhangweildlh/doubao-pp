{
  "name": "doubao-pp",
  "description": "为豆包网页版提供记忆、技能与自动化能力的浏览器扩展（Deepseek-pp 移植）",
  "private": true,
  "license": "Apache-2.0",
  "version": "1.11.6.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:chrome": "wxt build --browser chrome",
    "build:edge": "wxt build --browser edge",
    "build:firefox": "wxt build --browser firefox --mv3",
    "build:all": "npm run build:chrome && npm run build:edge && npm run build:firefox",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip --browser chrome",
    "zip:edge": "wxt zip --browser edge",
    "zip:firefox": "wxt zip --browser firefox --mv3",
    "zip:sources": "node scripts/package-sources.mjs",
    "zip:all": "npm run zip:chrome && npm run zip:edge && npm run zip:firefox && npm run zip:sources",
    "test": "vitest run",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "dexie": "^4.4.2",
    "pyodide": "^314.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/chrome": "^0.1.42",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8",
    "wxt": "^0.20.0"
  }
}
